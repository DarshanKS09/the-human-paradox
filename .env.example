# Ebook checkout configuration — placeholder names only. Never commit real secrets.
# Copy to .env.local and fill in values. All RAZORPAY_*, SMTP_*, DOWNLOAD_*,
# ORDERS_DB_PATH, EBOOK_PDF_PATH and APP_BASE_URL entries are server-only.

# Distribution mode: FREE (default, safe) or PAID.
# FREE = free claim flow, no payment. PAID = Razorpay checkout at the
# server-configured price. The browser can never choose this.
DISTRIBUTION_MODE=FREE

# Razorpay (test keys start with rzp_test_, live keys with rzp_live_)
# Only used when DISTRIBUTION_MODE=PAID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Persistent order database (PAID mode only; single-instance deployments)
ORDERS_DB_PATH=./data/orders.json

# Durable KV — PAID mode order storage on serverless only.
# NOT required for FREE mode (the free flow stores nothing).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- FREE delivery (DISTRIBUTION_MODE=FREE) --------------------------------
# REQUIRED. Google Drive share link for the ebook.
#   https://drive.google.com/file/d/<FILE_ID>/view?usp=sharing
# Set the Drive file to "Anyone with the link" so visitors can open it.
# NOTE: this is a public link - anyone who has it can download the ebook, and
# we cannot prevent re-sharing. Only https://drive.google.com links with a
# valid file id are accepted; anything else is ignored and claims fail closed.
EBOOK_DRIVE_URL=

# --- PAID delivery (DISTRIBUTION_MODE=PAID only) ---------------------------
# Private PDF sources for the protected download endpoint. Not used by the
# free Google Drive flow, and not required in the Vercel deployment for FREE.
EBOOK_PDF_PATH=./private/ebook.pdf
EBOOK_PDF_URL=
EBOOK_PDF_TOKEN=

# REQUIRED: random 32+ byte secret that signs download links.
# Without it, /api/free/claim returns 503 DELIVERY_UNAVAILABLE and no
# email is ever sent.
DOWNLOAD_TOKEN_SECRET=

# Transactional email via Brevo SMTP (requires a Brevo account,
# SMTP credentials, and a verified sender). Port 587 uses STARTTLS;
# port 465 uses implicit TLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# REQUIRED in production: the public origin used to build the download links
# that are emailed to customers. Without it, links fall back to
# http://localhost:3000 and every emailed link is broken.
APP_BASE_URL=https://your-domain.example

# Download security
# Time-to-live for download links, in hours
DOWNLOAD_LINK_TTL_HOURS=72
# Maximum downloads allowed per paid order
MAX_DOWNLOADS_PER_ORDER=5

# FREE mode needs no storage, no database and no download-token secret.
# Rate limiting (5 requests/minute per IP) and a 5-minute per-address
# cooldown are applied in memory; no external service is involved.
