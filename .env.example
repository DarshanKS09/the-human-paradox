# Ebook checkout configuration — placeholder names only. Never commit real secrets.
# Copy to .env.local and fill in values. All RAZORPAY_*, SMTP_*, DOWNLOAD_*,
# ORDERS_DB_PATH, EBOOK_PDF_PATH and APP_BASE_URL entries are server-only.

# Distribution mode: FREE (default, safe) or PAID.
# FREE = free claim flow, no payment. PAID = Razorpay checkout at the
# server-configured price. The browser can never choose this.
DISTRIBUTION_MODE=FREE

# Razorpay (test keys start with rzp_test_, live keys with rzp_live_)
# Only used when DISTRIBUTION_MODE=PAID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Persistent order database (file store; single-instance deployments)
ORDERS_DB_PATH=./data/orders.json

# Free-claim records (FREE mode). File store unless durable KV is set below.
FREE_CLAIMS_DB_PATH=./data/free-claims.json

# Durable KV (REQUIRED on Vercel — the local filesystem is ephemeral).
# Upstash Redis or Vercel KV REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Private ebook PDF — must live OUTSIDE public/. Never commit the real file.
# On Vercel prefer durable private object storage via EBOOK_PDF_URL, because
# the deployed filesystem is read-only and reset on every deployment.
EBOOK_PDF_PATH=./private/ebook.pdf
EBOOK_PDF_URL=
# Bearer token for private object storage, if your storage requires one
EBOOK_PDF_TOKEN=

# Transactional email via Brevo SMTP (requires a Brevo account,
# SMTP credentials, and a verified sender). Port 587 uses STARTTLS;
# port 465 uses implicit TLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Public base URL used to build download links in emails
APP_BASE_URL=

# Download security
DOWNLOAD_TOKEN_SECRET=
# Time-to-live for download links, in hours
DOWNLOAD_LINK_TTL_HOURS=72
# Maximum downloads allowed per paid order
MAX_DOWNLOADS_PER_ORDER=5

# FREE mode delivery limits
# Lifetime of each free download link, in hours
FREE_LINK_TTL_HOURS=72
# Minimum minutes between two emails to the same address
FREE_EMAIL_COOLDOWN_MINUTES=10
# Maximum emails per address per day
FREE_MAX_EMAILS_PER_DAY=3
# Maximum downloads per free claim link
FREE_MAX_DOWNLOADS_PER_CLAIM=10
